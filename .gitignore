# Dependencies
node_modules/

# Secrets — never commit
.env
.env.*
!.env.example

# Prisma generated client (re-created by `npm run db:generate`)
backend/src/generated/

# Logs / tests / build output
*.log
npm-debug.log*
coverage/
dist/

# Local database files and backups — keep database migrations/source scripts
*.sqlite
*.sqlite3
*.dump
*.backup
*.bak

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
# Local phase backups - do not upload
*.phase*-backup
*.old

# ERP (erp/) - .NET and Angular build output
erp/**/bin/
erp/**/obj/
erp/src/Erp.Api/wwwroot/
erp/web/node_modules/
erp/web/.angular/
erp/**/appsettings.*.local.json
*.user
erp/src/Erp.Api/App_Data/

# deployment: built packages and the per-server settings never go to git
deploy/release/
deploy/config.psd1
deploy/server/config.psd1
