# انسخ هذا الملف إلى .env ثم عدّل القيم. لا ترفع .env إلى Git أبدًا.

NODE_ENV=development
PORT=3000

# postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/shannana_foods

# سر توقيع JWT (32 حرفًا على الأقل). ولّده بالأمر:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# رقم واتساب بصيغة دولية بدون + أو مسافات
WHATSAPP_NUMBER=963985034031

# رقم واتساب استقبال الطلبات (مطلوب، وإلا لا يقلع التطبيق)
ORDER_WHATSAPP_NUMBER=963985034031

# اختياري: عنوان الموقع العام لروابط canonical و sitemap، مثل https://shannana-foods.com
SITE_URL=

# اختياري: عناوين مسموحة لـ CORS مفصولة بفاصلة (غير مطلوب إن كان الموقع يُخدَم من نفس الخادم)
CORS_ORIGINS=

# اختياري: عدد الـ proxies أمام التطبيق في الإنتاج (0 = لا يوجد)
TRUST_PROXY=0
