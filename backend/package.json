{
  "name": "shannana-foods-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Shannana Foods — Express + Prisma + PostgreSQL backend",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "predev": "prisma generate",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/server.js",
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "db:check": "node --disable-warning=ExperimentalWarning scripts/check-db.js",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:verify": "node --disable-warning=ExperimentalWarning scripts/verify-db.js",
    "db:seed": "node --disable-warning=ExperimentalWarning prisma/seed.js",
    "db:seed:verify": "node --disable-warning=ExperimentalWarning scripts/verify-seed.js",
    "db:drift": "prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --exit-code"
  },
  "dependencies": {
    "@digicole/pdfmake-rtl": "^2.1.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "0.45.1",
    "busboy": "1.6.0",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dotenv": "18.0.6",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "pg": "8.23.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "prisma": "7.10.0"
  },
  "allowScripts": {
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true,
    "argon2@0.45.1": true
  }
}
