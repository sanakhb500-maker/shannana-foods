<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development (hot reload, debugging). -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Debug builds may talk to a plain-http test server on the LAN; release builds are https only. -->
    <application android:usesCleartextTraffic="true"/>
</manifest>
