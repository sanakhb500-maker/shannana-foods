<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS hosting (in-process). `dotnet publish` fills in processPath / arguments; the rest is ours.
  Needs on the server: ASP.NET Core Hosting Bundle (.NET 10) and the IIS URL Rewrite module.
  The environment variables below are defaults; secrets and connection strings live in appsettings.Production.json
  next to the application (written by deploy/server/02-install-erp.ps1), never in this file.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\Erp.Api.dll" stdoutLogEnabled="true" stdoutLogFile=".\logs\stdout" hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
          <!-- first start (and every upgrade) creates / migrates the database and seeds the starter data; it is idempotent -->
          <environmentVariable name="Database__AutoMigrate" value="true" />
        </environmentVariables>
      </aspNetCore>

      <security>
        <requestFiltering removeServerHeader="true">
          <!-- proof-of-delivery uploads are at most 3 MB -->
          <requestLimits maxAllowedContentLength="5242880" />
        </requestFiltering>
      </security>

      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
          <add name="X-Content-Type-Options" value="nosniff" />
          <add name="Referrer-Policy" value="same-origin" />
          <add name="X-Frame-Options" value="DENY" />
        </customHeaders>
      </httpProtocol>

      <rewrite>
        <rules>
          <!-- plain http from outside the server is sent to https; calls from the server itself (health checks) stay on http -->
          <rule name="HttpsRedirect" stopProcessing="true">
            <match url="(.*)" />
            <conditions logicalGrouping="MatchAll">
              <add input="{HTTPS}" pattern="off" />
              <add input="{HTTP_HOST}" pattern="^localhost(:\d+)?$" negate="true" />
              <add input="{REQUEST_URI}" pattern="^/\.well-known/" negate="true" />
            </conditions>
            <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
          </rule>
        </rules>
      </rewrite>
    </system.webServer>
  </location>

  <!-- free https certificates (win-acme / Let's Encrypt) validate by fetching a plain file from here: let IIS serve it directly -->
  <location path=".well-known/acme-challenge">
    <system.webServer>
      <handlers>
        <remove name="aspNetCore" />
        <add name="StaticFile" path="*" verb="*" modules="StaticFileModule" resourceType="Either" requireAccess="Read" />
      </handlers>
      <staticContent>
        <remove fileExtension="." />
        <mimeMap fileExtension="." mimeType="text/plain" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
